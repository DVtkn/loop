# Локальный dev (npm run dev)
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Vercel прод (env задаются в дашборде Vercel, см. docs/DEPLOYMENT.md)
# VERCEL=1
# ALLOWED_ORIGINS=https://loopza.vercel.app

# ИИ-психолог «Сова» (опционально локально)
GROQ_API_KEY=
GEMINI_API_KEY=

# Web Push (VAPID) — генерация: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
